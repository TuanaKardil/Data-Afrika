# AfriEnrich environment variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git

# Required: Serper.dev API key for Google search + Maps
# Get yours at https://serper.dev — free tier: 2,500 searches/month
SERPER_API_KEY=your_serper_api_key_here

# Required: Anthropic API key for AI judge (Claude)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional
LOG_LEVEL=INFO
CACHE_TTL_DAYS=30
